{
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "endOfLine": "auto",
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "jsxSingleQuote": false,
    "vueIndentScriptAndStyle": false,
    "htmlWhitespaceSensitivity": "strict",
    "printWidth": 200
}
